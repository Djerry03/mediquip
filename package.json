{
  "name": "mediquip-monorepo",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "docker compose up -d && concurrently -k -n api,web -c magenta,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run start:dev",
    "build": "npm --workspace apps/api run build && npm --workspace apps/web run build",
    "test": "npm --workspace apps/api run test",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json",
    "migration:run": "npm --workspace apps/api run migration:run"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "5.6.3"
  }
}
