# =============================================================
# Mediquipe — variables d'environnement
# Copiez ce fichier en `.env` et remplacez les valeurs.
# ATTENTION : toute variable préfixée NEXT_PUBLIC_ est inlinée
# dans le bundle JavaScript envoyé au navigateur. N'y mettez
# JAMAIS de secret.
# =============================================================

# ---- Base de données PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mediquip

# ---- API ----
NODE_ENV=development
API_PORT=4000
# Origines autorisées par CORS, séparées par des virgules
CORS_ORIGINS=http://localhost:3004

# ---- Authentification ----
# Générez une valeur unique : openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_EXPIRES_IN=7d

# Compte administrateur créé au premier démarrage (seed).
# Changez le mot de passe avant toute mise en ligne.
ADMIN_EMAIL=admin@mediquipe.cm
ADMIN_PASSWORD=change-me-before-production

# ---- Paiement Mobile Money ----
# Laissez PAYMENT_PROVIDER=manual tant que vous n'avez pas de
# contrat marchand : les paiements sont alors confirmés à la main
# depuis le back-office (et le paiement à la livraison reste actif).
PAYMENT_PROVIDER=manual
MOMO_API_BASE_URL=
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CALLBACK_URL=http://localhost:4000/api/payments/webhook
# Secret partagé vérifiant la signature des webhooks entrants
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

# ---- Notifications ----
# `log` écrit les messages dans la console (aucune config requise).
# `smtp` envoie de vrais e-mails via les paramètres ci-dessous.
NOTIFICATION_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Mediquipe <no-reply@mediquipe.cm>"
# Adresse de l'équipe prévenue à chaque nouvelle commande
OPS_NOTIFICATION_EMAIL=commandes@mediquipe.cm

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3004
NEXT_PUBLIC_WHATSAPP_NUMBER=237600000000
